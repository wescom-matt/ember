{
  "version": 1,
  "projects": [
    {
      "name": "Outpost",
      "repo": "wescom-matt/Outpost",
      "language": "Dart, C++",
      "purpose": "Offline campsite chat: Flutter phone app + Heltec V3 WiFi/LoRa gateway firmware",
      "host": "Los Gatos",
      "folder": "C:\\Users\\Matt\\Documents\\Outpost",
      "backup_host": "Mint",
      "backup_folder": "~/projects/Outpost",
      "board": "Heltec WiFi LoRa 32 V3 (ESP32-S3 + SX1262)",
      "env": "heltec_v3_arduino3",
      "serial_port": "COMx on Los Gatos (Device Manager), /dev/ttyUSB0 on Mint",
      "commands": [
        {
          "name": "build",
          "cmd": "pio run -e heltec_v3_arduino3"
        },
        {
          "name": "build legacy (Arduino 2 / IDF 4.4)",
          "cmd": "pio run -e heltec_v3"
        },
        {
          "name": "flash",
          "cmd": "pio run -e heltec_v3_arduino3 -t upload --upload-port PORT"
        },
        {
          "name": "serial monitor",
          "cmd": "pio device monitor -b 115200 -p PORT"
        },
        {
          "name": "native tests",
          "cmd": "cmake -S . -B build && cmake --build build && ctest --test-dir build"
        },
        {
          "name": "loopback sim",
          "cmd": "pio run -e native"
        },
        {
          "name": "android app",
          "cmd": "bash scripts/pre_build_assets.sh android && flutter build apk --release --target-platform android-arm64"
        }
      ],
      "offline": {
        "platformio": true
      },
      "notes": "Ship env is heltec_v3_arduino3 (pioarduino 55.03.312, Arduino 3.3.12 / IDF 5.5.5); heltec_v3 is espressif32@7.1.3. iOS builds need a Mac."
    },
    {
      "name": "Outpost 2.0 (Heltec V4)",
      "repo": "",
      "language": "C++ (Arduino-ESP32 3.3.12)",
      "purpose": "PLANNED: next Outpost gateway on the Heltec WiFi LoRa 32 V4-R8 (ESP32-S3R8 + SX1262, 28 dBm)",
      "host": "Los Gatos",
      "folder": "C:\\Users\\Matt\\Documents\\Outpost2",
      "backup_host": "Mint",
      "backup_folder": "~/projects/Outpost2",
      "board": "Heltec WiFi LoRa 32 V4-R8 (ESP32-S3R8, 16 MB flash, 8 MB octal PSRAM, SX1262)",
      "env": "heltec_v4r8",
      "serial_port": "COMx on Los Gatos, /dev/ttyACM0 or /dev/ttyUSB0 on Mint",
      "commands": [
        {
          "name": "start from template",
          "cmd": "cp -r ~/ember/coldboot/outpost2-template ~/projects/Outpost2"
        },
        {
          "name": "build",
          "cmd": "pio run -e heltec_v4r8"
        },
        {
          "name": "flash",
          "cmd": "pio run -e heltec_v4r8 -t upload --upload-port PORT"
        },
        {
          "name": "serial monitor",
          "cmd": "pio device monitor -b 115200 -p PORT"
        }
      ],
      "offline": {
        "template": "coldboot/outpost2-template"
      },
      "notes": "No official PlatformIO board for V4/V4-R8 yet: the template carries an Ember custom board + pin variant (R8 pins from Heltec's V4-R8 datasheet). Arduino-ESP32 3.3.12 has a heltec_wifi_lora_32_V4 variant, but it matches the V4 R2 (QSPI PSRAM, LED 35, Vext 36). Not tested on hardware."
    },
