# Ember settings. install.sh copies this to ~/.config/ember/ember.env (mode 600).
# No passwords or keys go in this file.
EMBER_HOST=0.0.0.0
EMBER_PORT=8600
EMBER_DEFAULT_MODEL=qwen3.5-9b-4k
EMBER_OLLAMA_URL=http://127.0.0.1:11434
EMBER_QDRANT_URL=http://127.0.0.1:6333
EMBER_DATA_DIR=%h/.local/share/ember
EMBER_TLS_CERT=%h/.config/ember/tls/ember.crt
EMBER_TLS_KEY=%h/.config/ember/tls/ember.key
EMBER_SECURE_COOKIES=1
